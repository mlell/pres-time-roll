{
  "name": "classtimer",
  "version": "1.0.0",
  "description": "Classroom PDF Presenter with Management Tools",
  "main": "classtimer.html",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "npm run copy-pdfjs && npm run bundle",
    "copy-pdfjs": "cp node_modules/pdfjs-dist/build/pdf.min.mjs lib/js/pdf.min.mjs && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs lib/js/pdf.worker.min.mjs",
    "bundle": "esbuild lib/js/app.js --bundle --outfile=lib/js/bundle.js --format=iife"
  },
  "type": "module",
  "keywords": [
    "pdf",
    "timer",
    "classroom",
    "presenter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "^4.0.379"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2"
  }
}
